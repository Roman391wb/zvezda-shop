{
  "name": "ziyarat-admin-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:development": "wrangler deploy --env development",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "d1:migrate:local": "wrangler d1 migrations apply admin_v1 --local",
    "d1:migrate:development": "wrangler d1 migrations apply admin_v1 --env development",
    "d1:migrate:staging": "wrangler d1 migrations apply zvezda-admin-staging --remote --env staging",
    "d1:migrate:production": "wrangler d1 migrations apply ziyarat-admin-production --remote --env production",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^22.15.3",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.3",
    "wrangler": "^4.10.0"
  }
}
