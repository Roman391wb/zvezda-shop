# Copy to .env.production on the production host; chmod 600 .env.production.
# Do not commit that file and do not reuse development credentials.
APP_ENV=production
DOMAIN=replace-with-real-domain.example
PUBLIC_ORIGIN=https://replace-with-real-domain.example
ACME_EMAIL=replace-with-operations-email@example.com
POSTGRES_DB=ziyarat
POSTGRES_USER=ziyarat_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://ziyarat_app:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/ziyarat
SEED_DEMO_DATA=false
ADMIN_BOOTSTRAP_LOGIN=admin
# Existing bootstrap hash only. Leave blank after the first ADMIN is already present.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=REPLACE_WITH_A_64_PLUS_CHARACTER_RANDOM_SECRET
ADMIN_COOKIE_SECURE=true
BACKEND_INTERNAL_URL=http://api:8000
TRUSTED_PROXY_CIDRS=172.30.0.0/24
MAX_UPLOAD_BYTES=10485760
MAX_VIDEO_UPLOAD_BYTES=62914560
NEXT_PUBLIC_STORE_NAME=
NEXT_PUBLIC_STORE_WHATSAPP_NUMBER=
BACKUP_RETENTION_DAYS=30
