# Local-development defaults only. Never use these values for a public launch.
APP_ENV=development
POSTGRES_DB=atelier
POSTGRES_USER=atelier
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+asyncpg://atelier:change-me-locally@postgres:5432/atelier
BACKEND_INTERNAL_URL=http://api:8000
# Optional local-only LAN binding, for example 192.168.1.25. Keep loopback by default.
WEB_BIND_IP=127.0.0.1
SEED_DEMO_DATA=false
ADMIN_BOOTSTRAP_LOGIN=admin
# bcrypt hash only; never put an admin password here.
ADMIN_PASSWORD_HASH=
# Generate at least 32 random bytes, for example: openssl rand -base64 48
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=false
MAX_UPLOAD_BYTES=10485760
MAX_VIDEO_UPLOAD_BYTES=62914560
NEXT_PUBLIC_STORE_NAME=
NEXT_PUBLIC_STORE_WHATSAPP_NUMBER=
